# ────────────────────────────────────────────────
# Libraries
# ────────────────────────────────────────────────

library(ggplot2)
library(dplyr)
library(reshape2)

# ────────────────────────────────────────────────
# Load data
# ────────────────────────────────────────────────

asv.counts <- read.csv("data/ASV_table.csv", row.names = 1)
LLNEXT.metadata <- read.delim("data/LLNEXT_metadata.txt")
tax_table <- read.csv("data/tax_regrouped_single_items.csv") # individual items condensed by logic rather than ASV variation

# ────────────────────────────────────────────────
# Filtering
# ────────────────────────────────────────────────

# Filter out control & blank
control <- rownames(asv_filtered0)[grep("control", rownames(asv_filtered0))]
asv_filtered1 <- asv_filtered0[!(row.names(asv_filtered0) %in% control),]

blank <- rownames(asv_filtered1)[grep("blank", rownames(asv_filtered1))]
asv_filtered <- asv_filtered1[!(row.names(asv_filtered1) %in% blank),]

rownames(asv_filtered) <- gsub(".*-(.*)-.*", "\\1", rownames(asv_filtered))

# Select metadata
metadata_selected <- LLNEXT.metadata[LLNEXT.metadata$NG_ID %in% rownames(asv_filtered), c("NG_ID", "Type", "FAMILY", "Timepoint_categorical", "SAMPLE_ID")]

# Melt
asv_filtered$NG_ID <- rownames(asv_filtered) 
asv_long <- melt(asv_filtered, id.vars = "NG_ID", variable.name = "ASV", value.name = "Count")

asv_long_merged <- merge(asv_long, tax_table[ , c("ASV", "assigned_group")], by = "ASV", all = T)

asv_long_merged <- asv_long_merged[!is.na(asv_long_merged$assigned_group), ]

# Set presence threshold
asv_long_merged$Count[asv_long_merged$Count <= 3] <- 0

asv_long_merged <- aggregate(Count ~ NG_ID + assigned_group, data = asv_long_merged, FUN = sum)


# ────────────────────────────────────────────────
# Merge ASV counts with metadata
# ────────────────────────────────────────────────

asv_long_merged <- merge(asv_long_merged, metadata_selected, by = "NG_ID", all=T)

# Wide
asv_table <- dcast(asv_long_merged, NG_ID ~ assigned_group, value.var = "Count")

foodseq <- asv_table %>%
  mutate(across(-NG_ID, ~ ifelse(. > 0, 1, 0)))


# ─────────────────────────────────────────────
# Prep data for plotting
# ─────────────────────────────────────────────

metadata_selected$Timepoint_categorical <- factor(metadata_selected$Timepoint_categorical, levels = c("M9", "M12", "M3"),
                                                  labels = c("Infant (M9)", "Infant (M12)", "Mother"))

foods <- setdiff(names(foodseq), "NG_ID")

combined_data <- merge(metadata_selected,foodseq, by = "NG_ID", all = T)

# transform data
combined_data_long <- reshape(
  combined_data,
  varying = foods,
  v.names = "present",
  timevar = "food",
  times = foods,
  direction = "long"
)

tab <- aggregate(
  present ~ Type + Timepoint_categorical + food,
  data = combined_data_long,
  FUN = function(x) 100 * mean(x)
)

# ─────────────────────────────────────────────
# Plot
# ─────────────────────────────────────────────

fill_cols <- c("Infant (M9)"  = "#A6D8FF","Infant (M12)" = "#F2C77C","Mother" = "#66C2A3")

border_cols <- c("Infant (M9)"  = "#2E7DB2","Infant (M12)" = "#B77700","Mother" = "#006D5B")

timepoints <- unique(tab$Timepoint_categorical)


top_list <- list()
for (tp in timepoints) {
  sub <- tab[tab$Timepoint_categorical == tp, ]
  avg_food <- aggregate(present ~ food, data = sub, mean)
  top10 <- avg_food[order(-avg_food$present), ][1:min(10, nrow(avg_food)), ]
  top_list[[tp]] <- top10
}

food_map <- c(
  "Cabbage, broccoli, cauliflower, etc." = "Cruciferous vegetables",
  "Carrots, parsnips, parsley, dill, cumin, and fennel" = "Apiaceae herbs and roots",
  "Potatoes and sweet potatoes" = "Potatoes",
  "Strawberries, raspberries, and blackberries" = "Rosaceae berries",
  "Peach, apricot, cherry, etc." = "Stone fruits",
  "Black pepper, etc." = "Black pepper"
)

top_list <- lapply(top_list, function(df) {
  df$food <- as.character(df$food)
  is_renamed <- df$food %in% names(food_map)
  df$food[is_renamed] <- food_map[df$food[is_renamed]]
  df
})

group_spacing <- 2
bar_width <- 0.8

x_positions <- c()
heights <- c()
cols <- c()
borders <- c()
labels <- c()
group_centers <- c()
x_start <- 0
separator_x <- c()

for (i in seq_along(timepoints)) {
  tp <- timepoints[i]
  n <- nrow(top_list[[i]])
  x_pos <- x_start + seq_len(n)
  
  x_positions <- c(x_positions, x_pos)
  heights    <- c(heights, top_list[[i]]$present)
  cols       <- c(cols, rep(fill_cols[tp],   n))
  borders    <- c(borders, rep(border_cols[tp], n))
  labels     <- c(labels, top_list[[i]]$food)
  
  group_centers <- c(group_centers, mean(x_pos))
  
  if (i < length(timepoints)) {
    separator_x <- c(separator_x, x_pos[n] + group_spacing / 2)
  }
  
  x_start <- x_pos[n] + group_spacing
}

par(mar = c(5.1, 4.1, 4.1, 2.1))

plot(0, type = "n",
     xlim = c(0, max(x_positions) + bar_width),
     ylim = c(-45, 110),
     xaxt = "n", yaxt = "n",
     xlab = "",
     ylab = "",
     main = "Plant")

mtext("Food DNA", side = 1, line = 1)
mtext("Percentage of Samples", side = 2, line = 2.2, adj = 0.7)

# y-axis
axis(2, at = seq(0, 100, by = 20), labels = seq(0, 100, by = 20))

# x-axis
abline(h = 0)

# Bars
rect(xleft  = x_positions - bar_width / 2,
     xright = x_positions + bar_width / 2,
     ybottom = 0,
     ytop    = heights,
     col     = cols,
     border  = borders,
     lwd     = 2)

# Vertical separators
abline(v = separator_x, col = "grey50", lty = 2)

# Bar labels
text(x = x_positions, y = -5, labels = labels,
     srt = 65, adj = 1, xpd = TRUE, cex = 0.7)

# Group titles
text(x = group_centers, y = 100, labels = timepoints,
     font = 2, xpd = TRUE, adj = c(0.5, -0.5))

box()

mtext("A", side = 3, adj = 0, line = 1.5, font = 2, cex = 1.5)
